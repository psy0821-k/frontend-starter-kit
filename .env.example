# Supabase
NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# service_role 키 — 서버 전용(NEXT_PUBLIC_ 접두사 없음), 클라이언트 번들에 노출되지 않는다.
# src/shared/api/supabase/admin.ts에서만 참조한다. 브라우저/클라이언트 컴포넌트에서 절대 사용 금지.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# 회원가입 인증 메일 발송(Resend)은 애플리케이션 코드가 아닌 Supabase Dashboard의
# Authentication > Emails > SMTP Settings에서 Custom SMTP로 직접 설정한다.
# (Host: smtp.resend.com, Port: 465, Username: resend, Password: Resend API Key)
# 관련 환경변수는 이 프로젝트 코드에서 필요하지 않다.
